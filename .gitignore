# Dependencies
node_modules/
.pnpm-store/

# Build output
# Prisma client is generated from prisma/schema.prisma; `pnpm db:generate` recreates it.
packages/database/generated/
dist/
build/
.next/
out/
*.tsbuildinfo

# Test and coverage output
coverage/
.vitest/
playwright-report/
test-results/
.playwright/
# E2E session file: a real bearer token, written by `e2e/global-setup.ts`
**/e2e/.auth/

# Local runtime state (contract §4, §15 A5) — never committed, never backed up
.temporal/
.artifacts/
# Disposable execution workspaces (`WORKSPACE_ROOT`). One directory per agent run,
# deleted by the cleaner; never committed, never backed up.
.workspaces/

# Turbo (not used today; harmless if a later unit adds it)
.turbo/

# Secrets — .env is never committed, .env.example always is
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Editor / OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
