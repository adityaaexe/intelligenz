{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Test files are not part of the shipped program, but they are still type-checked:
    // a test that compiles by accident is a test that asserts the wrong shape.
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
