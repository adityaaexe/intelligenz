{
  "name": "@intelligenz/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --passWithNoTests --dir test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@intelligenz/contracts": "workspace:*",
    "@intelligenz/database": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.10",
    "argon2": "0.45.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.10",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2"
  }
}
