{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@intelligenz/contracts": ["packages/contracts/src/index.ts"],
      "@intelligenz/contracts/plan-hash": ["packages/contracts/src/plan-hash.ts"],
      "@intelligenz/database": ["packages/database/src/index.ts"],
      "@intelligenz/design-system": ["packages/design-system/src/index.ts"],
      "@intelligenz/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@intelligenz/egress-broker": ["packages/egress-broker/src/index.ts"],
      "@intelligenz/workspace-manager": ["packages/workspace-manager/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
