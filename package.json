{
  "name": "intelligenz",
  "version": "0.0.0",
  "private": true,
  "description": "INTELLIGENZ — autonomous AI engineering and intelligence harness with an enterprise control plane",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=4 run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "dev": "bash infra/scripts/dev.sh",
    "db:bootstrap": "bash infra/scripts/bootstrap-db.sh",
    "temporal:start": "bash infra/scripts/start-temporal.sh",
    "verify": "bash infra/scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
