{
  "name": "intelligenz",
  "version": "0.2.0",
  "description": "Deterministic, tamper-evident run journals for multi-agent systems.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "intelligenz": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "example": "npm run build && node examples/record-and-verify.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "agents",
    "llm",
    "observability",
    "replay",
    "audit",
    "provenance",
    "hash-chain"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
