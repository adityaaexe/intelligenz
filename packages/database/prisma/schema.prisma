// INTELLIGENZ — data model.
//
// Phase 2 aggregate (ADR-004, ADR-005, contract §5–§7, §15 A2/A3/A5) plus the
// Phase 3 execution identity: where a run executed (`ExecutionWorkspace`), which
// attempt it was (`ExecutionAttempt`), and what it did (`ToolInvocation`).
//
// Phase 4 (DB-401) makes execution defensible without widening it. Five additive
// changes, no column dropped, narrowed, or reinterpreted:
//   - `ApprovalRequest` becomes a bound, expiring, single-use grant;
//   - `Artifact` gains direct attempt/workspace provenance instead of a time-window
//     heuristic;
//   - `ExecutionAttempt` records the resources it used and why it stopped;
//   - `ExecutionWorkspace` gains a lease and a cleanup ledger, so a reaper can act
//     on evidence rather than on age;
//   - `Task` records where its risk class came from.
// No evaluation tables: the Phase 4 eval harness stores JSON on disk.
//
// Phase 5 (BE-501) adds one column, for one reason: `WorkflowRun.idempotencyKey` lets a
// retried `POST /run` be answered from the run the first request created instead of
// reserving a second `ExecutionAttempt`. The approval→attempt link itself needs no column:
// `ApprovalRequest.consumedByAttemptId` already points at `ExecutionAttempt`, and
// `ExecutionAttempt.workflowRunId` already points at the run, so the chain is complete.
//
// Conventions enforced here, not just documented:
//   - every tenant-owned table carries a non-null `orgId`, indexed;
//   - composite indexes lead with `orgId` so a tenant list query is a range scan;
//   - money is Decimal(12,4), never Float;
//   - ids are opaque uuid strings, never sequential integers;
//   - deletes cascade from Organization down to Task, and are restricted where
//     history must survive (ApprovalRequest, AuditEvent, ExecutionAttempt,
//     ExecutionWorkspace);
//   - every Phase 3 column added to a Phase 2 table is nullable or defaulted, so
//     existing rows survive the migration unaltered.
//
// Phase 8.6 adds the programme layer: three tables and two enums, all additive.
//
// `POST /run` starts exactly one task workflow and ends. Nothing dispatches task B when
// task A completes, and no row says "these tasks are one objective". A `Programme` is
// that row, `ProgrammeTask` is the dependency graph, and `ProgrammeCheckpoint` is the
// ordered record of what the parent workflow observed.
//
// Deliberately back-fill-free: every existing `Task` stays valid and unparented. A
// programme is always created with its graph in one transaction, so there is no legacy
// row that would need an invented graph.
//
// Phase 8.7 adds the proposal layer: `Plan` and `PlanStatus`, one table and one enum, all
// additive. A plan is what a planner proposed and what a human decided about it; it is
// *not* a schedule. `Programme` still records only what is scheduled, and the only writer
// that turns one into the other is `POST /plans/:id/submit`.
//
// Prisma 7: the connection URL lives in `prisma.config.ts`, not in this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────
// These mirror `@intelligenz/contracts/src/enums.ts` exactly. Postgres enum
// labels are case-sensitive; a rename is a migration, so the two files must be
// changed together.

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum RiskClass {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  draft
  ready
  queued
  running
  verifying
  succeeded
  failed
  blocked
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

/// Phase 4 adds two terminal states. `EXPIRED` means the grant ran past its own
/// `expiresAt` without being used; `REVOKED` means a human withdrew it before use.
/// Both are distinct from `REJECTED`, which is a decision made at request time:
/// an approval that was granted and then aged out is not a rejection, and
/// reporting it as one hides the fact that execution was once authorised.
///
/// Append-only. Existing labels are never removed or reordered — a Postgres enum
/// label is positional on disk, and renaming one is a table rewrite.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
  REVOKED
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled
  timed_out
}

enum ActorType {
  user
  agent
  system
}

/// Lifecycle of a programme — one submitted objective, executed as a dependency graph of
/// tasks. `blocked` is reserved for "work remains and nothing can run" (a task waiting for
/// an approval, or a graph that never became eligible); `failed` means at least one task
/// failed. The two are different operator situations and collapsing them hides which.
///
/// Append-only, same rule as `ApprovalStatus`: a Postgres enum label is positional on
/// disk, and renaming one is a table rewrite.
enum ProgrammeStatus {
  pending
  running
  succeeded
  failed
  blocked
  cancelled
  timed_out
}

/// Per-node state inside a programme. Distinct from `TaskStatus` on purpose: a task is
/// `ready` on the board while its programme node is `pending` behind a dependency. The two
/// vocabularies answer different questions and are never derived from one another.
///
/// `waiting_for_approval` is terminal for this run's scheduler but not a failure: nothing
/// is blocked by it except its own dependents, and a human still has to approve.
enum ProgrammeTaskStatus {
  pending
  running
  succeeded
  failed
  blocked
  waiting_for_approval
  cancelled
}

/// Phase 8.7. The proposal lifecycle, deliberately *not* `ProgrammeStatus`.
///
/// `proposed` and `invalid` are what the planner produced; `approved` and `rejected` are
/// what a human decided; `submitted` means the approved content was materialised into
/// tasks and a programme. Nothing else may create execution rows: approval alone does not,
/// and only `submit` reads `approved`.
///
/// Append-only, same rule as the other enums: a Postgres enum label is positional on disk
/// and renaming one is a table rewrite.
enum PlanStatus {
  proposed
  invalid
  approved
  rejected
  submitted
}

enum Environment {
  prod
  staging
  dev
}

/// Execution workspace lifecycle (Phase 3). `preserving` is the window between
/// "the run finished" and "the bytes are archived or removed": a separate state so
/// a cleanup that failed is visible as `failed` rather than silently implied.
///
/// Phase 4 adds the states a durable reaper needs. The Phase 3 vocabulary described
/// what happened to a run; it did not describe what happens to the directory after
/// the process that owned it is gone. `failed` was overloaded for both "the run
/// failed" and "the cleanup failed", which made a leaked directory indistinguishable
/// from a successful run whose bytes were simply still there.
///
///   allocated       → a row exists and a path is reserved, nothing written yet
///   finalizing      → the run is over; artifacts still being collected
///   cleanup_pending → reclaimable, queued for the reaper
///   cleaned         → bytes gone, verified
///   cleanup_failed  → the reaper tried and failed; retried with a backoff
///   quarantined     → deliberately retained (incident, evidence hold), never reaped
///
/// Append-only, same rule as ApprovalStatus.
enum WorkspaceState {
  requested
  provisioning
  ready
  executing
  preserving
  completed
  failed
  cancelled
  allocated
  finalizing
  cleanup_pending
  cleaned
  cleanup_failed
  quarantined
}

// ─── Identity and tenancy ────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces       Workspace[]
  memberships      Membership[]
  projects         Project[]
  tasks            Task[]
  workflowRuns     WorkflowRun[]
  agentRuns        AgentRun[]
  artifacts        Artifact[]
  evidence         Evidence[]
  approvalRequests ApprovalRequest[]
  auditEvents      AuditEvent[]

  executionWorkspaces ExecutionWorkspace[]
  executionAttempts   ExecutionAttempt[]
  toolInvocations     ToolInvocation[]

  programmes           Programme[]
  programmeTasks       ProgrammeTask[]
  programmeCheckpoints ProgrammeCheckpoint[]

  /// Phase 8.7: proposals made in this tenant.
  plans Plan[]
}

model Workspace {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects     Project[]
  tasks        Task[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model User {
  id           String   @id @default(uuid())
  // Stored lower-cased at the application boundary (contract §15 A5). The unique
  // index is therefore case-insensitive in practice without a `citext` dependency.
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        Membership[]
  createdTasks       Task[]            @relation("TaskCreatedBy")
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequestedBy")
  decidedApprovals   ApprovalRequest[] @relation("ApprovalDecidedBy")
  // Phase 8.7. Restrict on all three: a person who proposed or decided a plan is part of
  // its history, and deleting the account must not erase who approved what.
  createdPlans       Plan[]            @relation("PlanCreatedBy")
  approvedPlans      Plan[]            @relation("PlanApprovedBy")
  rejectedPlans      Plan[]            @relation("PlanRejectedBy")
}

model Membership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Project {
  id          String      @id @default(uuid())
  orgId       String
  workspaceId String
  key         String
  name        String
  environment Environment
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks        Task[]
  auditEvents  AuditEvent[]
  programmes   Programme[]
  /// Phase 8.7: proposals scoped to this project.
  plans        Plan[]

  @@unique([workspaceId, key])
  @@index([orgId])
  @@index([orgId, createdAt])
}

// ─── Work ────────────────────────────────────────────────────────────────────

model Task {
  id                 String       @id @default(uuid())
  orgId              String
  projectId          String
  // Denormalised from Project: a tenant filter that needs a join is a filter
  // that gets omitted (ADR-004).
  workspaceId        String
  title              String
  goal               String
  status             TaskStatus   @default(draft)
  // Phase 4 (D-006). Until Phase 4 this column was written from the request body and
  // nothing verified it, so "riskClass: LOW" was a client assertion, not a
  // classification. The column keeps its meaning in this migration — what changes is
  // that the API will start deriving it server-side and recording the derivation in
  // the four columns below. Existing rows keep `riskSource = 'client'`, which is the
  // truthful description of how they were produced.
  riskClass          RiskClass
  /// `client` | `server`. Which authority produced `riskClass`. A string rather than
  /// an enum: the vocabulary is policy-owned and grows (`client`, `server`, later
  /// `replayed`), and a Postgres enum cannot gain a value in the same transaction as
  /// the code that writes it.
  riskSource         String       @default("client")
  /// The server's own classification, kept beside the effective one rather than
  /// replacing it, so a disagreement between the two is visible instead of resolved
  /// by overwriting. Null for rows no server policy has evaluated.
  derivedRiskClass   RiskClass?
  /// Which policy produced `derivedRiskClass`. Without it, a class is unattributable
  /// a week later when the thresholds have changed.
  riskPolicyVersion  String?
  /// The inputs and rule hits behind `derivedRiskClass`, e.g.
  /// `{ signals: ["network-write"], matchedRules: [...] }`. JSON because the shape
  /// belongs to the policy engine, not to the schema.
  riskFactors        Json?
  priority           TaskPriority @default(normal)
  // Postgres `text[]`. Acceptable for Phase 2; normalising into a child table is
  // a later migration if criteria ever need per-item status.
  acceptanceCriteria String[]
  createdById        String
  // Client-supplied per project. `(projectId, idempotencyKey)` unique makes a
  // duplicate POST return the existing task instead of a second row (contract §6).
  idempotencyKey     String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization     Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workflowRuns     WorkflowRun[]
  artifacts        Artifact[]
  evidence         Evidence[]
  approvalRequests ApprovalRequest[]

  executionWorkspaces ExecutionWorkspace[]
  executionAttempts   ExecutionAttempt[]

  programmeTasks       ProgrammeTask[]
  programmeCheckpoints ProgrammeCheckpoint[]

  @@unique([projectId, idempotencyKey])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([projectId, status])
}

model WorkflowRun {
  id            String    @id @default(uuid())
  orgId         String
  taskId        String
  workflowId    String
  // Assigned by Temporal when the workflow actually starts; null while queued.
  temporalRunId String?   @unique
  status        RunStatus @default(queued)
  startedAt     DateTime?
  finishedAt    DateTime?
  error         Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ─── Phase 5: request identity ───────────────────────────────────────────
  /// The client's `Idempotency-Key` for the `POST /run` that created this row. Nullable
  /// because every run created before the column existed carried no key, and back-filling
  /// one would assert a request nobody made. A retry that supplies the same key is
  /// answered from this row — same `WorkflowRun`, same `ExecutionAttempt`, no second
  /// attempt — instead of starting a second execution. Postgres treats NULLs as distinct
  /// in a unique index, so the legacy rows coexist while duplicate keys collide.
  idempotencyKey String?

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentRuns    AgentRun[]
  attempts     ExecutionAttempt[]

  // One request key, one run. Scoped by task rather than org: two tasks may legitimately
  // be started with the same client-generated key.
  @@unique([taskId, idempotencyKey])
  @@index([orgId, createdAt])
  @@index([orgId, status])
  @@index([taskId, createdAt])
}

model AgentRun {
  id            String    @id @default(uuid())
  orgId         String
  workflowRunId String
  runtimeId     String
  model         String
  status        RunStatus @default(queued)
  startedAt     DateTime?
  finishedAt    DateTime?
  tokensIn      Int       @default(0)
  tokensOut     Int       @default(0)
  // Advisory only in Phase 2 — recorded, never enforced (contract §15 A7).
  costUsd       Decimal?  @db.Decimal(12, 4)
  error         Json?
  createdAt     DateTime  @default(now())

  // ─── Phase 3: execution identity ─────────────────────────────────────────
  // A retry is a new row, not a mutation of the old one. `attemptNumber` is the
  // 1-based position of this run inside its workflow run, so "the third attempt"
  // is addressable without reading `createdAt`.
  attemptNumber  Int     @default(1)
  // The directory this run was confined to: `ExecutionWorkspace`, NOT the tenant
  // `Workspace` four models up. Two different concepts sharing one word; see the
  // model comment. Nullable because every Phase 2 row predates the concept.
  workspaceId    String?
  // False means "a real runtime produced this". Phase 2 rows were all
  // `local-simulated`, and ADR-006 already required them to report `simulated:
  // true`, so the migration backfills them rather than letting the column default
  // relabel history as real execution.
  simulated      Boolean @default(false)
  // Reported by the adapter (`opencode --version`), not inferred from `runtimeId`.
  runtimeVersion String?
  // Provider-shaped detail: routing, cache read/write, provider request id.
  providerMeta   Json?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflowRun  WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  // Where this run executed (`AgentRun.workspaceId`).
  executionWorkspace  ExecutionWorkspace?  @relation("AgentRunExecutionWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)
  // The same link from the other side (`ExecutionWorkspace.agentRunId`). Both
  // directions exist because each side is queried on its own terms: "which
  // directory did this run use" and "which runs are attributed to this directory".
  executionWorkspaces ExecutionWorkspace[] @relation("ExecutionWorkspaceAgentRun")
  attempts            ExecutionAttempt[]
  toolInvocations     ToolInvocation[]

  @@index([orgId, createdAt])
  @@index([workflowRunId])
  // Not a read index: a SetNull foreign key needs one or every parent delete
  // sequential-scans this table to find the rows it must null out.
  @@index([workspaceId])
}

model Artifact {
  id        String   @id @default(uuid())
  orgId     String
  taskId    String
  // The runtime instance that produced it (`LocalSimulatedRuntime`, ...). Not a
  // foreign key: an artifact outlives the run record that mentioned it.
  runtimeId String
  kind      String
  // `uri` may legitimately move (a different artifact root); the checksum is what
  // identifies the content.
  uri       String
  checksum  String
  sizeBytes BigInt
  createdAt DateTime @default(now())

  // ─── Phase 4: direct provenance ──────────────────────────────────────────
  // Phase 3 attributed an artifact to an attempt by comparing timestamps, which is
  // a guess: two attempts in the same second, or a clock that steps, produce the
  // wrong answer and nothing detects it. These are the explicit links.
  //
  // Both nullable and never backfilled. NULL means "unattributed", which is the
  // honest description of every artifact written before this column existed; the
  // API reports it as such rather than inventing an attempt for it.
  attemptId   String?
  /// The directory the producing run was confined to. Carried separately from
  /// `attemptId` because a workspace can outlive the attempt row that used it, and
  /// "which bytes came out of this directory" survives that.
  workspaceId String?

  // ─── Phase 6: is this evidence authority, or a report? ───────────────────
  // An artifact's checksum proves the bytes have not changed since the worker wrote
  // them. It says nothing about **who decided what the bytes mean**: a `diff.patch`
  // produced by `git diff` inside the workspace is a claim by a program the agent can
  // configure, and `git add` made that claim empty for a fully rewritten tree.
  //
  // Three columns, all additive and all defaulted, so every existing row keeps its
  // current meaning without a back-fill:
  /// `host-snapshot` — bytes produced by a host walk, not by a repository.
  /// `git-in-sandbox` — a git report. Display-only; never authority.
  /// NULL — predates the distinction, so it is neither.
  evidenceSource        String?
  /// True only when a host process measured these bytes and the measurement was
  /// complete. Default false: an artifact written before this column existed was never
  /// authority, and saying otherwise after the fact is exactly the rewrite this
  /// column exists to prevent.
  authoritative         Boolean @default(false)
  /// For a `change-manifest`: the digest of its canonical body. Equal to `checksum` by
  /// construction, and recorded separately so a row whose two values disagree is
  /// detectable rather than merely suspicious.
  manifestDigest        String?
  /// The two snapshot digests the manifest compares, denormalised so "which trees did
  /// this describe" is answerable without parsing the artifact.
  initialManifestDigest String?
  finalManifestDigest   String?

  organization       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task               Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: an artifact is content-addressed evidence and outlives the
  // bookkeeping that produced it. Deleting an attempt must not delete the bytes'
  // record — it must make the provenance honest again (NULL), not erase the artifact.
  executionAttempt   ExecutionAttempt?   @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  executionWorkspace ExecutionWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  // Content-addressed: a retried `persistResultActivity` that produces identical bytes
  // is the same artifact, and the database now refuses a second row for it. The worker's
  // deterministic id made this an application-level hope; this makes it a guarantee.
  @@unique([orgId, taskId, kind, checksum])
  @@index([orgId, taskId])
  @@index([taskId, createdAt])
  // Read path: "what did attempt N produce".
  @@index([attemptId])
  // Also foreign-key maintenance: a SetNull parent delete without this index
  // sequentially scans the table.
  @@index([workspaceId])
}

model Evidence {
  id         String   @id @default(uuid())
  orgId      String
  taskId     String
  kind       String
  uri        String
  // Actor id (user or agent) as an opaque string; deliberately not a foreign key.
  producedBy String
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // One evidence row per claim about a given location. `Evidence` carries no checksum
  // column, so `uri` is the stable identity available; a retried activity must not
  // double-count the trail.
  @@unique([orgId, taskId, kind, uri])
  @@index([orgId, taskId])
}

// ─── Execution (Phase 3) ─────────────────────────────────────────────────────
//
// Three questions the Phase 2 schema could not answer, each with its own table:
//
//   where  → `ExecutionWorkspace`  a disposable directory, with a lifecycle
//   which  → `ExecutionAttempt`    "was this the first try or the fourth?"
//   what   → `ToolInvocation`      a redacted, ordered trace of tool use
//
// Naming warning: this section's `ExecutionWorkspace` is a filesystem boundary for
// one run. It is unrelated to `Workspace` above, which is a tenant-scoped grouping
// that owns projects. Never join them, never call both "workspace" in code that
// reads both.

/// A disposable filesystem boundary in which one agent run executes.
///
/// `rootPath` is the identity that matters operationally: it is unique so two rows
/// can never claim the same directory, and the workspace manager can therefore
/// answer "is this path already leased?" with one index probe rather than a scan.
model ExecutionWorkspace {
  id         String         @id @default(uuid())
  orgId      String
  taskId     String
  // Which run this directory belongs to. SetNull rather than Cascade: losing the
  // run record must not erase the evidence that a directory exists on disk. The
  // cleaner is what removes the bytes, and it needs the row to still be there.
  agentRunId String?
  state      WorkspaceState @default(requested)
  // Absolute, canonical (no `..`, no symlink segments). Unique across all tenants
  // because the filesystem is shared, not partitioned by org.
  rootPath   String         @unique
  // `clone` | `worktree` | `empty`. Deliberately not an enum: the set grows as
  // adapters are added, and a Postgres enum cannot be extended inside a
  // transaction. Validated at the application boundary.
  sourceKind String
  // Repository URL for `clone`/`worktree`, source directory for `empty`.
  sourceRef  String?
  // Recorded so a run is reproducible even if the branch moves underneath it.
  baseCommit String?
  branch     String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  // Null until the directory is usable / until it has been removed or archived.
  readyAt    DateTime?
  cleanedAt  DateTime?
  // Retention deadline. Null means "no deadline set"; the sweeper treats an
  // expired row as reclaimable, it never implies immediate deletion.
  expiresAt  DateTime?
  // Container for the provisioning or cleanup failure: `{ stage, message, code }`.
  // JSON because the error shape belongs to the workspace manager, not the schema.
  error      Json?

  // ─── Phase 4: durable lifecycle ──────────────────────────────────────────
  // Phase 3 knew a workspace existed and what state it reached; it did not know who
  // currently owned it, whether that owner was still alive, or how many times
  // reclamation had been attempted. Without those three facts a reaper cannot
  // distinguish "a live run" from "a directory left behind by a dead worker", and
  // the safe default is to reap nothing — which is why Phase 3 had no reaper.
  //
  // The lease is advisory at the database level and enforced by a conditional
  // UPDATE (`... WHERE "leaseExpiresAt" IS NULL OR "leaseExpiresAt" < now()`), so
  // two workers can never both believe they hold the same directory.
  leaseExpiresAt  DateTime?
  /// Worker identity holding the lease. Opaque (`host:pid:bootId`); deliberately not
  /// a foreign key — workers are processes, not rows.
  leaseOwner      String?
  /// Last liveness signal from the lease holder. A row whose heartbeat is stale but
  /// whose lease has not expired is already suspect and should be logged, not reaped.
  lastHeartbeatAt DateTime?
  cleanupAttempts Int       @default(0)
  /// The reaper's failure detail, separate from `error` above: `error` is why the run
  /// did not work, this is why the bytes are still on disk. `{ stage, message, code }`.
  cleanupError    Json?

  // ─── Phase 6: host-owned evidence ────────────────────────────────────────
  // The agent used to be the author of the evidence used to judge it: the patch an
  // approver read came from `git diff` run against a repository the agent could
  // configure, and `git add`/`git commit` made that patch empty while changing every
  // byte. These columns record what a **host** walk measured instead.
  //
  // All three are nullable and deliberately not back-filled. A row written before the
  // walk existed has no digest, and NULL says that; a synthesised value would be
  // indistinguishable from a measurement.
  /// SHA-256 of the snapshot taken immediately after the lease, before the agent
  /// process exists. This is the baseline a change is measured against.
  initialManifestDigest String?
  /// SHA-256 of the snapshot taken after the run ended — on success, failure and
  /// cancellation alike. NULL means the final walk never completed.
  finalManifestDigest   String?
  /// When the baseline was captured. The *final* instant lives inside the manifest
  /// body rather than in a second column: one column and one body beat two columns
  /// that can disagree.
  snapshotAt            DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  // Cascade: the directory is owned by the task; if the task is deleted the
  // directory is orphaned by definition and the row must not linger.
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation("ExecutionWorkspaceAgentRun", fields: [agentRunId], references: [id], onDelete: SetNull)
  agentRuns    AgentRun[]   @relation("AgentRunExecutionWorkspace")
  artifacts    Artifact[]

  // The state board: "what is provisioning or executing in this org right now".
  @@index([orgId, state])
  // "Show me every workspace this task ever used" — the retry history view.
  @@index([taskId])
  // Tenant-scoped listing, newest first.
  @@index([orgId, createdAt])
  // Foreign-key maintenance for the SetNull above, not a read path.
  @@index([agentRunId])
  // The reaper's driving query: state is the filter, the deadline is the range and
  // the sort. Leading with `state` keeps it usable for the per-state counts the
  // dashboard needs as well.
  @@index([state, leaseExpiresAt])
}

/// One execution of one workflow run.
///
/// The reason this table exists: a Temporal retry re-runs an activity, and Phase 2
/// had no way to say whether a second `AgentRun` was a retry of the first or an
/// independent run. `(workflowRunId, attemptNumber)` is that identity.
model ExecutionAttempt {
  id            String    @id @default(uuid())
  orgId         String
  taskId        String
  workflowRunId String
  // Null while the attempt has not produced a run yet (queued, or the runtime
  // failed to start). SetNull so pruning run records never destroys the attempt.
  agentRunId    String?
  // 1-based. No default: the caller must state which attempt this is, because
  // guessing is exactly the bug this column exists to prevent.
  attemptNumber Int
  // Adapter identity, e.g. `opencode-cli`, `local-simulated`. Not an enum and not
  // a foreign key: adapters ship independently of the database.
  runtimeId     String
  // Load-bearing, not decorative. True means no real model call happened. The UI
  // labels every row from this column, and a mismatch against the adapter's own
  // report is a test failure (Phase 3 baseline §7).
  simulated     Boolean   @default(false)
  status        RunStatus @default(queued)
  startedAt     DateTime?
  finishedAt    DateTime?
  error         Json?
  createdAt     DateTime  @default(now())

  // ─── Phase 4: resource accounting ────────────────────────────────────────
  // Recorded, not yet enforced. Phase 3 limited a run with rlimits only, which bound
  // per-process usage but not aggregate usage: a run that forked was unbounded in
  // total. These columns are what a cgroup-backed limiter has to write for the limit
  // to be auditable, and what "was this attempt killed or did it fail on its own"
  // is answered from. All nullable: no Phase 3 row has these values, and a fabricated
  // zero would be indistinguishable from a measured one.
  /// Which resource profile the attempt ran under (e.g. `standard`, `heavy`). Null
  /// means the attempt predates profiles, not "default".
  executionProfile  String?
  /// CPU consumed, in milliseconds, as reported by the supervisor after the process
  /// group exited. Not wall time.
  cpuTimeMs         Int?
  /// Peak resident set. Bytes, because the numbers involved do not fit comfortably in
  /// an Int and a silent overflow is worse than a slightly wider column.
  memoryPeakBytes   BigInt?
  /// Peak concurrent process count, for the pids limit.
  pidsPeak          Int?
  /// Why the attempt stopped: `completed | timeout | cancelled | oom | pids | cpu |
  /// crashed`. A string, not an enum, for the same reason as `riskSource`: the set is
  /// owned by the supervisor and grows without a migration. Null means "not recorded",
  /// which is not the same as `completed`.
  terminationReason String?
  /// State of the cleanup pass for this attempt's workspace: `pending | done |
  /// failed | skipped`. Separate from the attempt's `status` because an attempt can
  /// succeed and still leave bytes behind.
  cleanupState      String?

  // ─── Phase 6: the one-shot execution claim ───────────────────────────────
  /// The **Temporal** run id (`workflowInfo().runId` in the workflow;
  /// `Context.current().info.workflowExecution.runId` in the activity) of the one
  /// execution that claimed this attempt for execution. NULL means unclaimed.
  ///
  /// Not the same id space as `workflowRunId` above: that column is a foreign key to
  /// `WorkflowRun.id`, which the API writes *before* the workflow exists. This column
  /// holds the orchestrator's per-execution id, which is what distinguishes two
  /// executions from one execution retrying an activity. The name follows the phase
  /// contract; the comment exists because the collision is otherwise a trap.
  ///
  /// Write-once. The only writer is a conditional UPDATE whose predicate requires
  /// `status = 'queued'` and this column NULL, so a second claimant gets count 0
  /// instead of a second grant.
  claimedByWorkflowRunId String?
  /// The **workflow id** the claiming execution was started under, read from
  /// `Context.current().info.workflowExecution.workflowId` at claim time and written in
  /// the same conditional UPDATE as the run id above.
  ///
  /// Recorded, never derived (Phase 6 re-review N7). A run id alone does not identify an
  /// execution: Temporal's `describeWorkflowExecution` is keyed by workflow id **and**
  /// run id, so asking about `task-<taskId>` plus somebody else's run id answers
  /// NOT_FOUND for a perfectly live execution — and the release pass would free a claim
  /// that is still held. This column is what makes the probe exact instead of assumed.
  ///
  /// NULL means the claim predates this column. Those rows cannot be probed exactly, so
  /// the release pass skips them (`unknown`, fail closed) rather than guessing a workflow
  /// id for them. Never back-filled: a fabricated id would be indistinguishable from an
  /// observed one.
  claimedByWorkflowId    String?
  /// When the claim was granted. NULL means never claimed — never back-filled, because
  /// a fabricated timestamp would make an unclaimed row indistinguishable from a
  /// claimed one.
  claimedAt              DateTime?

  // Restrict: attempt history is the audit trail for "how many times did we try".
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowRun  WorkflowRun  @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  // The other side of the single-use approval link (Phase 4). One attempt may consume
  // many approvals; an approval is consumed by at most one attempt, enforced by the
  // conditional UPDATE the API performs, not by a unique constraint — a revoked
  // approval that was never consumed must keep `consumedByAttemptId` NULL.
  consumedApprovals ApprovalRequest[] @relation("ExecutionAttemptConsumedApproval")
  artifacts         Artifact[]

  // A workflow run cannot claim attempt 3 twice. A retried activity that tries to
  // insert a duplicate gets P2002 instead of a second silent row.
  @@unique([workflowRunId, attemptNumber])
  @@index([orgId, createdAt])
  // Foreign-key maintenance for the SetNull above, not a read path.
  @@index([agentRunId])
  // The claim read path: "which attempt did this execution claim", and the operator
  // question "what did run X claim". Not unique: one execution may legitimately hold
  // several attempts (a retry after a crash is a new attempt), so uniqueness is per
  // (attempt), enforced by the conditional UPDATE, not per claim holder.
  @@index([claimedByWorkflowRunId])
}

/// Ordered, redacted record of what an agent did during a run.
///
/// Not a transcript. `summary` is a human-readable, already-redacted one-liner
/// (tool name, target, outcome) capped at 500 characters in the database so a
/// careless caller cannot smuggle a full payload in. Raw input and output belong in
/// an `Artifact`, where the checksum makes them verifiable and the storage policy
/// makes them expirable; a table that every list query scans is the wrong home for
/// megabytes of model text.
model ToolInvocation {
  id         String   @id @default(uuid())
  orgId      String
  agentRunId String
  // Monotonic within a run, assigned by the adapter. Ordering is by this column,
  // not by timestamp: two tool calls can share a millisecond, and a clock can move.
  sequence   Int
  // Tool identifier as the runtime named it (`read`, `edit`, `bash`, `task`).
  tool       String
  summary    String   @db.VarChar(500)
  // Observed time, supplied by the adapter. No default: the database must not
  // invent a time for something that happened elsewhere.
  occurredAt DateTime

  // Cascade from both parents: this is derived evidence, and it is worthless
  // without the run it describes or the tenant that owns it.
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  // Also the index that serves "everything this run did", in order.
  @@unique([agentRunId, sequence])
  // Tenant-wide activity feed, newest first.
  @@index([orgId, occurredAt])
}

// ─── Governance ──────────────────────────────────────────────────────────────
//
// Phase 4 turns an approval from a row that says "somebody said yes" into a grant
// that is bound to what was approved, expires, and can be spent exactly once.
//
// The Phase 3 shape had three holes, each closed by a column group below:
//
//   1. Nothing bound the decision to the content it approved. A task could be
//      edited between approval and execution and the approval still applied.
//      → `taskContentHash`, `riskClassAtApproval`, `policyVersion`,
//        `executionProfile`
//   2. Nothing consumed an approval, so one `APPROVED` row authorised every retry
//      forever.
//      → `consumedAt`, `consumedByAttemptId`
//   3. Nothing withdrew an approval, so a stale grant was indistinguishable from a
//      live one.
//      → `expiresAt`, `revokedAt`, `revokedById`

model ApprovalRequest {
  id            String         @id @default(uuid())
  orgId         String
  taskId        String
  riskClass     RiskClass
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decisionNote  String?
  createdAt     DateTime       @default(now())
  decidedAt     DateTime?

  // ─── Phase 4: binding ────────────────────────────────────────────────────
  /// sha256 of the task's goal plus its acceptance criteria, in a canonical
  /// serialisation, computed at the moment the decision was recorded. Execution
  /// recomputes it and refuses to proceed on a mismatch — that is the whole point:
  /// the grant is for this content, not for this row id.
  ///
  /// Nullable because approvals created before Phase 4 have no hash, and inventing
  /// one now would assert that the content at approval time is the content today.
  /// A null hash is therefore "unbound" and must be treated as not usable for an
  /// automatic execution gate; the API decides that, the column only records.
  taskContentHash     String?
  /// The risk class the approver actually saw. `riskClass` above is what the row was
  /// created with; if classification is re-run later the two diverge, and the audit
  /// question is "what was this person told" — answered by this column.
  riskClassAtApproval RiskClass?
  /// Which policy version produced `riskClassAtApproval`. Same reason as
  /// `Task.riskPolicyVersion`: a class without its policy is unattributable later.
  policyVersion       String?
  /// Which execution profile the grant authorises (`standard`, `heavy`, ...). A grant
  /// for a light profile must not authorise a heavier one, so the profile is part of
  /// what was approved rather than an execution-time choice.
  executionProfile    String?

  // ─── Phase 4: lifetime ───────────────────────────────────────────────────
  /// When the grant stops being usable. Null means "no expiry recorded", which is the
  /// honest state of pre-Phase-4 rows; the execution gate treats a null expiry as
  /// unbounded and applies its own ceiling rather than pretending there is one here.
  expiresAt           DateTime?
  /// Single use. Set by a conditional UPDATE that also requires `consumedAt IS NULL`
  /// and `status = 'APPROVED'`, so two concurrent workers cannot both spend the same
  /// grant — the second update affects zero rows.
  consumedAt          DateTime?
  /// Which attempt spent it. SetNull rather than Restrict: attempt rows are prunable
  /// bookkeeping, while the approval is governance history that must survive pruning.
  /// Losing the attempt makes the link unknown (`NULL`), not the consumption undone —
  /// `consumedAt` remains, so the grant is still spent.
  consumedByAttemptId String?

  // ─── Phase 4: withdrawal ─────────────────────────────────────────────────
  /// Set when a human withdraws a grant that was previously approved. `status`
  /// becomes `REVOKED` in the same write; the timestamp exists so "when" is
  /// answerable without reading the audit log.
  revokedAt   DateTime?
  /// Actor id of whoever revoked it. Deliberately **not** a foreign key, unlike
  /// `decidedById`: revocation is an escape hatch that must remain available even
  /// when the actor's user row is being removed, and a Restrict FK here would let a
  /// pending user deletion block an incident response. Same posture as
  /// `Evidence.producedBy`.
  revokedById String?

  organization      Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  // Restrict: a task with an approval history must not vanish underneath it.
  task              Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  requestedBy       User              @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy         User?             @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  consumedByAttempt ExecutionAttempt? @relation("ExecutionAttemptConsumedApproval", fields: [consumedByAttemptId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, status])
  @@index([taskId])
  // The execution gate's query: "is there a live grant for this task in this org".
  // Covers the filter and yields the sort key; `[orgId, status]` above cannot serve
  // it without scanning every approval in the tenant.
  @@index([orgId, taskId, status])
  // Expiry sweeper: `WHERE "expiresAt" < now() AND status = 'APPROVED'`.
  @@index([expiresAt])
  // Foreign-key maintenance for the SetNull above, not a read path.
  @@index([consumedByAttemptId])
}

/// Append-only history. Rows are written, never updated: the mutable aggregate
/// holds current state, this table explains how it got there (ADR-004).
model AuditEvent {
  id             String    @id @default(uuid())
  orgId          String
  projectId      String?
  actorType      ActorType
  actorId        String
  action         String
  aggregateType  String
  aggregateId    String
  eventType      String
  correlationId  String
  causationId    String?
  idempotencyKey String
  payload        Json
  occurredAt     DateTime

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  // SetNull: losing a project must not erase the record that it existed.
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([orgId, idempotencyKey])
}

// ─── Programmes (Phase 8.6) ──────────────────────────────────────────────────
//
// The scheduling layer that did not exist. `POST /run` starts one task workflow and
// ends; a `Programme` is the durable statement that several tasks are one objective, and
// `ProgrammeTask.dependsOn` is the only dependency edge in the system.
//
// The parent workflow reads this graph, dispatches the existing `runTaskWorkflow` as
// children, and records what it observed. It does **not** authorise execution: the claim,
// the approval binding and the evidence capture stay inside the task workflow, untouched.

/// One submitted objective, executed as a graph of existing tasks.
///
/// `idempotencyKey` is required, not optional like `Task.idempotencyKey`: a programme
/// submission starts a durable parent workflow, and "submit twice while the first is
/// being accepted" is the one duplicate that must not create two schedules. `(orgId,
/// idempotencyKey)` makes the second submission return the first programme instead.
model Programme {
  id             String          @id @default(uuid())
  orgId          String
  projectId      String
  /// The human statement of what this programme is for. Not parsed, not executed.
  objective      String
  status         ProgrammeStatus @default(pending)
  idempotencyKey String
  /// Why the programme stopped when it did, when the reason is not a task failure
  /// (`ORCHESTRATOR_UNAVAILABLE` at submission, `DEADLINE_EXCEEDED`, `GRAPH_INVALID`).
  /// A failed programme with no reason is unattributable a week later.
  failureReason  String?
  /// The machine-readable companion to `failureReason`: one of
  /// `PROGRAMME_REASON_CODES` (`@intelligenz/contracts`), written in the same conditional
  /// UPDATE that closes the programme. `failureReason` stays prose because an operator
  /// reads it; this column is what the API filters, groups and projects to telemetry.
  ///
  /// NULL means **"this row predates the column"**, and must be read as `UNSPECIFIED` for
  /// a terminal non-success — never as success. A succeeded programme also holds NULL,
  /// because a success has no failure code; the API distinguishes the two by status and
  /// answers `null` for success, `UNSPECIFIED` for a terminal failure with no code.
  failureCode    String?
  /// Set by the parent workflow's first activity, not by the API: "the scheduler is
  /// running" is a fact only the scheduler can report.
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks       ProgrammeTask[]
  checkpoints ProgrammeCheckpoint[]
  /// Phase 8.7: the approval that authorised this programme, if it came from a plan.
  plan        Plan?

  // Submission idempotency. Scoped by org: two tenants may use the same client key.
  @@unique([orgId, idempotencyKey])
  // The tenant's programme list, newest first.
  @@index([orgId, createdAt])
  // "What is running in this project right now" — the board query.
  @@index([projectId, status])
}

/// One node of a programme's graph.
///
/// `dependsOn` holds **task ids**, not `ProgrammeTask` ids. That choice is load-bearing:
/// the graph is authored by whoever submits the programme (a human today, a planner
/// later), and the author knows task ids because the tasks already exist. Server-minted
/// `ProgrammeTask` ids would force a two-step "create nodes, then wire them" API for no
/// benefit. `@@unique([programmeId, taskId])` makes the reference unambiguous.
model ProgrammeTask {
  id           String              @id @default(uuid())
  orgId        String
  programmeId  String
  taskId       String
  /// Task ids this node waits for. Validated for cycles, self-dependency, duplicates and
  /// missing members before anything is dispatched; the array is stored verbatim.
  dependsOn    String[]            @default([])
  status       ProgrammeTaskStatus @default(pending)
  /// How many times the programme reserved an execution attempt for this node. Written
  /// as an assignment from the workflow's deterministic attempt number, never as `+1`,
  /// so a retried activity cannot inflate it.
  attemptCount Int                 @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  programme    Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  // Restrict: a task that a programme scheduled is part of that programme's record.
  // Deleting it would leave a graph with an unresolved reference, so the delete is
  // refused instead. Tenant teardown removes programme rows first (see the test helper).
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)

  // One node per task per programme. Also the lookup the dispatcher makes before it
  // reserves anything.
  @@unique([programmeId, taskId])
  // The readiness scan: "which nodes of this programme are still pending".
  @@index([programmeId, status])
  // Foreign-key maintenance for the Restrict reference above.
  @@index([taskId])
}

/// Append-only record of what the parent workflow observed, in order.
///
/// `sequence` is 1-based, allocated by the workflow (which knows how many it has already
/// written) and made unique per programme, so a retried write is an upsert rather than a
/// duplicate. The checkpoint is the durable answer to "what happened, in what order" —
/// the E2E asserts it instead of asserting that the workflow returned.
model ProgrammeCheckpoint {
  id          String   @id @default(uuid())
  orgId       String
  programmeId String
  sequence    Int
  taskId      String
  /// `succeeded` | `failed` | `blocked` | `waiting_for_approval` | `already_succeeded` |
  /// `cancelled` | `dispatch_failed` | `precondition_failed` | `held_elsewhere` |
  /// `programme_terminal`. A string, not an enum, for the same reason as
  /// `terminationReason`: the vocabulary belongs to the scheduler and grows without a
  /// migration.
  outcome     String
  /// The evidence for the outcome: the attempt and workflow run that executed the task,
  /// the child execution as Temporal named it, and the child's own verdict. JSON because
  /// the shape belongs to the scheduler, not to the schema.
  evidence    Json?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  programme    Programme    @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  // Restrict, same reasoning as `ProgrammeTask.task`: this is the programme's history.
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)

  // The workflow's deterministic sequence. A retried `recordProgrammeCheckpointActivity`
  // hits this key and upserts instead of appending a second row.
  @@unique([programmeId, sequence])
  // "What happened to this task, in order" — the per-task evidence chain.
  @@index([programmeId, taskId])
  // Foreign-key maintenance for the Restrict reference above.
  @@index([taskId])
}

/// One proposal by a planner, and the human decision about it.
///
/// ## Why this table exists beside `Programme`
///
/// `Programme` records what is scheduled. A `Plan` records what was *proposed* — the
/// model's output, the deterministic validation of it, and the approval that authorises
/// materialisation. Keeping them apart is what makes "the planner proposes, a human
/// authorises, the workflow executes" checkable rather than aspirational: there is a row
/// that exists between the proposal and the schedule, and it carries who approved which
/// bytes.
///
/// ## Provenance is a server column, never a proposal field
///
/// `provider`, `providerModel` and `simulated` are columns here because the proposal is
/// stored as untrusted JSON. The model's response cannot populate them — `ProposedPlanV1`
/// is strict and has no such keys — and the API writes them from the provider
/// implementation that actually made the call.
///
/// ## `approvedContentHash` is nullable until a decision exists
///
/// A proposal that never reached a decision was never approved, so there is no content it
/// authorises. Back-filling a hash on approval would invent a review; a null is the honest
/// state and is why submission refuses a plan whose status is not `approved` before it ever
/// looks at the hash.
///
/// ## Delete behaviour
///
/// The organisation, project and programme references cascade/set-null: pruning a project
/// or a programme must not destroy the approval record, so `programmeId` is `SetNull`. The
/// three user references are `Restrict`, matching `ApprovalRequest`: a person who proposed
/// or decided a plan is named in its history, and deleting the account would erase it.
model Plan {
  id          String     @id @default(uuid())
  orgId       String
  projectId   String
  /// The objective the planner was given, as it was given. Bounded by the proposal schema.
  objective   String
  status      PlanStatus @default(proposed)
  /// The provider implementation's name (`http-llm`). Written by the API, never the model.
  provider    String
  /// The configured model id, or null when the provider has none.
  providerModel String?
  /// True unless the provider actually performed a model call. Defaults to true.
  simulated   Boolean    @default(true)
  /// The validated `ProposedPlanV1`. Untrusted input, stored verbatim for review.
  proposal    Json
  /// `{ ok, issues }` from `validateProposedPlan` at proposal time. Recomputed on submit.
  validation  Json
  /// sha256 of `canonicalPlanContent(proposal)`, written when the decision is recorded.
  /// Recomputed at submission and compared; a mismatch refuses. Nullable because a
  /// proposal that never reached a decision was never approved.
  approvedContentHash String?
  approvedById       String?
  approvedAt         DateTime?
  approvalExpiresAt  DateTime?
  rejectedById       String?
  decidedAt          DateTime?
  decisionNote       String?
  /// Set exactly once, by submission, under a conditional update on `status = 'approved'`.
  programmeId        String?  @unique
  createdById        String
  /// Client key scoped by organisation: two tenants may use the same value.
  idempotencyKey     String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?        @relation("PlanApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy   User?        @relation("PlanRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  /// SetNull: pruning a programme must not destroy the approval that authorised it.
  programme    Programme?   @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  // Proposal idempotency. Scoped by org for the same reason as `Programme`.
  @@unique([orgId, idempotencyKey])
  // The tenant's review queue, filtered by state.
  @@index([orgId, status])
  // "What was proposed recently" — the default list order.
  @@index([orgId, createdAt])
}
