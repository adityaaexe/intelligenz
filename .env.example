# INTELLIGENZ — environment template
#
# Copy to `.env` (gitignored) and adjust. Every value below is a LOCAL DEV
# default or a placeholder. Nothing here is a real credential.
#
# Ports: web 3100 and api 4100. NOT 3000/4000 — those belong to another
# product's backend on this host (contract §15 A1). Ports 7233/8233 are free.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API (apps/api) ─────────────────────────────────────────────────────────
# 4100 is required on this host; 4000 is occupied by an unrelated service.
API_PORT=4100
API_HOST=0.0.0.0
# Public base URL of the API, used by clients and Playwright.
API_URL=http://localhost:4100

# ─── Web (apps/web) ─────────────────────────────────────────────────────────
# 3100 is required on this host; 3000 is occupied by an unrelated service.
WEB_PORT=3100
# NEXT_PUBLIC_* is inlined into the browser bundle. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ─── Database (PostgreSQL 18, host instance) ────────────────────────────────
# Local dev only. `infra/scripts/bootstrap-db.sh` creates this role and database.
DATABASE_URL=postgresql://intelligenz:intelligenz@localhost:5432/intelligenz_dev
# Separate database for integration tests, so a test run cannot truncate dev data.
TEST_DATABASE_URL=postgresql://intelligenz:intelligenz@localhost:5432/intelligenz_test
# `prisma migrate dev` needs a shadow database it can write to. This role cannot
# create databases, so the bootstrap script must create this one up front:
#   sudo -u postgres createdb -O intelligenz intelligenz_shadow
# `prisma migrate deploy` (bootstrap, CI) does not use it.
SHADOW_DATABASE_URL=postgresql://intelligenz:intelligenz@localhost:5432/intelligenz_shadow

# ─── Cache / queue (Redis 8, host instance) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Workflows (Temporal dev server) ────────────────────────────────────────
# Start with `infra/scripts/start-temporal.sh` (SQLite store at .temporal/dev.db).
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=intelligenz-tasks
# Attempts per gRPC call, including the first (SDK default: 10). Set to 1 only for a
# process pointed at an address nothing listens on: the retry timer outlives the call.
# TEMPORAL_RPC_MAX_ATTEMPTS=10

# ─── Worker resource enforcement (Phase 8.3) ────────────────────────────────
# The delegated cgroup the worker and its per-attempt leaves live in. Created once
# by `sudo bash infra/scripts/setup-cgroups.sh`; the worker must then be started
# through `sudo bash infra/scripts/worker-with-cgroup.sh`.
WORKER_CGROUP_ROOT=/sys/fs/cgroup/intelligenz
# Escape hatch from the boot-time execution-enforcement gate. **Default: off.**
#
# A worker outside its delegated cgroup runs every task with rlimit-only
# enforcement, so since Phase 8.3 it refuses to start instead. Only set this for a
# process that does not execute tasks (a diagnostics or migration runner). Setting
# it on a worker that polls a task queue removes CPU/memory/PID/I/O enforcement and
# makes that removal invisible in the boot log — which is the defect the gate exists
# to close. Do not set it in a deployment that executes work.
# WORKER_ALLOW_UNENFORCED_EXECUTION=false

# ─── Proposal planner (Phase 8.7) ───────────────────────────────────────────
# An OpenAI-compatible chat-completions endpoint. All three are required together:
# if any is absent, the planner is **not configured** and `POST /plans` answers
# `503 PLANNER_UNAVAILABLE` without creating a row. There is no fallback planner —
# a service that invented tasks from an objective would be worse than an outage.
#
# The base URL must be http: or https:. Each request goes to
# `<base>/chat/completions` with `response_format: json_object`; there are no
# retries inside the service (a retry doubles spend and latency for the same
# answer — the client retries).
# PLANNER_BASE_URL=http://127.0.0.1:8080/v1
# PLANNER_API_KEY=replace-with-a-real-key
# PLANNER_MODEL=some-model-id
# Per-call timeout. A timeout is `503 PLANNER_UNAVAILABLE`, not a bad response.
# PLANNER_TIMEOUT_MS=30000
# How long an approved plan may be submitted. Default 24, same shape as
# APPROVAL_TTL_HOURS: an expired approval must be granted again.
# PLANNER_APPROVAL_TTL_HOURS=24

# ─── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED. There is no default and no fallback: the API refuses to boot without
# a real signing key. Generate one and paste it into `.env`:
#
#   openssl rand -hex 32
#
# The value below is a deliberately invalid placeholder. Copying this file to
# `.env` without generating a key must fail at startup with an explicit message.
# That is the point — a public signing key lets anyone mint a token for any user.
JWT_SECRET=REPLACE_ME
# HS256, access token TTL 15 minutes (contract §5).
JWT_ACCESS_TTL_SECONDS=900

# ─── Artifacts ──────────────────────────────────────────────────────────────
# Worker, API and seed must agree on this path (contract §15 A5). Gitignored.
ARTIFACT_ROOT=.artifacts

# ─── Execution (Phase 3, broker-authenticated since Phase 4) ────────────────
# Adapter selection. `local-simulated` (the default) performs no real work and
# spends nothing. `opencode-cli` runs a real, credentialed agent inside `bwrap`.
# Real execution is opt-in on purpose: a deployment that forgot this variable
# must not silently start spending provider credit.
AGENT_RUNTIME=local-simulated
# Where real runs lease a disposable checkout. Gitignored. The API reads the same
# variable so it can serve a run's transcript from `<workspace>/artifacts`.
WORKSPACE_ROOT=.workspaces
# Repository a real run is cloned from. Unset means an empty workspace. A relative
# path resolves against the repository root.
# WORKSPACE_SOURCE_REPO=infra/fixtures/sample-repo
# **Upstream** model id (the sandbox sees `izbroker/<key>`). Required when
# `AGENT_RUNTIME=opencode-cli`; there is no default, because a wrong one is a charge.
# AGENT_MODEL=gemini-3.5-flash

# ─── Egress broker (required by a real runtime) ─────────────────────────────
# Provider authentication happens on the host, in the broker. The sandbox holds no
# credential, no credential database and no provider config — only a per-attempt canary
# that authenticates nothing. Removing the broker removes the model channel; there is no
# unproxied fallback.
#
# Upstream base URL, including its path prefix. The broker appends the request path
# (`/v1/chat/completions`) to this, so the sandbox never names a host.
# AGENT_BROKER_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# Where the real key is read. Either an opencode integration id from the SQLite store
# below, or `AGENT_BROKER_CREDENTIAL_ENV` naming an environment variable. Never printed,
# never written, never mounted.
# AGENT_BROKER_CREDENTIAL=google
# AGENT_BROKER_CREDENTIAL_DB=/home/ubuntu/.local/share/opencode/opencode.db
# AGENT_BROKER_CREDENTIAL_ENV=PROVIDER_API_KEY
#
# Requests one attempt may make through the broker. Bounds spend and runaway SDK loops.
# AGENT_BROKER_MAX_REQUESTS=400
# Hard per-run spend cap in USD. **Shipped with a value, not commented out**: a real
# adapter with no cap is an unlimited purchase order, and "the operator forgot to set a
# variable" is not a reason to run one. `0` is refused at boot when
# `AGENT_RUNTIME=opencode-cli`. Unset means 0.5.
AGENT_MAX_USD=0.5
# `bwrap` executable, resolved on PATH when omitted.
# AGENT_BWRAP_PATH=/usr/bin/bwrap
# Scratch directory the adapter owns (per-run config, broker socket, evidence log).
# It must stay short: the adapter builds
# `<scratch>/opencode-cli/<taskId>-<suffix>/broker/broker.sock`, and a unix socket path
# over 107 bytes is silently truncated at bind time — which shows up as ECONNRESET on
# every provider call. Boot fails with an explanation if this is too long.
# AGENT_RUNTIME_SCRATCH_ROOT=/tmp/intelligenz-runtime

# ─── Observability ──────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ─── E2E (Playwright) ───────────────────────────────────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3100
